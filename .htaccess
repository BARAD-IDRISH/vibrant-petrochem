# ====================================================================
# A2 Hosting cPanel Phusion Passenger / Apache .htaccess Configuration
# Project: Vibrant Petrochem FZE (Next.js App Router)
# ====================================================================

# DO NOT REMOVE: CloudLinux / cPanel Passenger Configuration
<IfModule mod_passenger.c>
  PassengerAppRoot "/home/USERNAME/public_html"
  PassengerBaseURI "/"
  PassengerNodejs "/home/USERNAME/nodevenv/public_html/20/bin/node"
  PassengerAppType node
  PassengerStartupFile server.js
</IfModule>

# HTTPS Enforcement & Clean URL Rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS Security
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Serve static files directly if exist
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Route all other requests to Node.js Phusion Passenger runner
  RewriteRule ^(.*)$ server.js [L]
</IfModule>

# Gzip Compression for Optimal Performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
