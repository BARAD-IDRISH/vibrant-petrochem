# ====================================================================
# A2 Hosting cPanel Static Export .htaccess Configuration
# Project: Vibrant Petrochem FZE (Static HTML Export)
# ====================================================================

Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.vibrantpetro\.com$ [NC]
  RewriteRule ^(.*)$ https://vibrantpetro.com/$1 [R=301,L]

  # 3. DIRECT EXEMPTION: Never rewrite _next assets or media files
  RewriteRule ^_next/ - [L]
  RewriteRule ^.+\.(css|js|jpg|jpeg|png|gif|svg|ico|webp|woff|woff2|ttf|eot)$ - [L]

  # 4. Serve existing static files & directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Clean URL routing for static HTML pages (e.g. /contact -> contact.html)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 6. Legacy 301 Redirects for 2018 pages (.php to clean URLs)
  RewriteRule ^index\.php$ / [R=301,L]
  RewriteRule ^about\.php$ /about [R=301,L]
  RewriteRule ^services\.php$ /services [R=301,L]
  RewriteRule ^industries\.php$ /industries [R=301,L]
  RewriteRule ^products\.php$ /products [R=301,L]
  RewriteRule ^contact\.php$ /contact [R=301,L]
</IfModule>

# Fallback for non-existent routes (Serve Home Page)
ErrorDocument 404 /index.html

# MIME Types for Static Assets (CSS, JS, WebP, WOFF2)
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# Gzip Compression for Optimal Performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
