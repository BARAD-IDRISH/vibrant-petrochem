# ====================================================================
# A2 Hosting cPanel Phusion Passenger / Apache .htaccess Configuration
# Project: Vibrant Petrochem FZE (Next.js App Router)
# ====================================================================

# DO NOT REMOVE: CloudLinux / cPanel Passenger Configuration
<IfModule mod_passenger.c>
  PassengerAppRoot "/home/USERNAME/public_html"
  PassengerBaseURI "/"
  PassengerNodejs "/home/USERNAME/nodevenv/public_html/20/bin/node"
  PassengerAppType node
  PassengerStartupFile server.js
</IfModule>

# HTTPS Enforcement & Legacy .php 301 Redirect Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS Security
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Legacy Live .php URLs 301 Redirects (Preserving SEO & Google Rankings)
  RewriteRule ^index\.php$ / [R=301,L]
  RewriteRule ^contact\.php$ /contact [R=301,L]
  RewriteRule ^base_oil\.php$ /products/base-oil [R=301,L]
  RewriteRule ^gtl_fuel\.php$ /products/gtl-fuel [R=301,L]
  RewriteRule ^n_parafin\.php$ /products/n-paraffins [R=301,L]
  RewriteRule ^fuel_oil\.php$ /products/fuel-oil [R=301,L]
  RewriteRule ^glycols\.php$ /products/glycols [R=301,L]
  RewriteRule ^mineral_oil\.php$ /products/mineral-oil [R=301,L]
  RewriteRule ^jet_a1\.php$ /products/jet-a1 [R=301,L]
  RewriteRule ^gpso\.php$ /products/spindle-oil [R=301,L]
  RewriteRule ^distillate_oil\.php$ /products/distillate-oil [R=301,L]
  RewriteRule ^recidual_oil\.php$ /products/process-oil [R=301,L]
  RewriteRule ^thinner\.php$ /products/thinners-diluents [R=301,L]
  RewriteRule ^degreasing_solvent\.php$ /products/degreasing-solvents [R=301,L]
  RewriteRule ^naphtha_oil\.php$ /products/naphtha-oil [R=301,L]

  # 3. Serve static files directly if present
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Route all remaining requests to Node.js Phusion Passenger runner
  RewriteRule ^(.*)$ server.js [L]
</IfModule>

# Gzip Compression for Optimal Performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
