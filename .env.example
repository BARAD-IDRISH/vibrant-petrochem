# ===============================================
# Vibrant Petrochem FZE - Email & SMTP Settings
# (A2 Hosting / cPanel SMTP Configuration)
# ===============================================

# Host for A2 Hosting email (e.g. mail.vibrantpetro.com or smtp.a2hosting.com)
SMTP_HOST=mail.vibrantpetro.com

# Port 465 for SSL (recommended) or 587 for TLS
SMTP_PORT=465

# true for SSL (port 465), false for TLS (port 587)
SMTP_SECURE=true

# Sender / Authentication Email Account
SMTP_USER=ashish@vibrantpetro.com

# Email Account Password (Set in A2 Hosting cPanel / Webmail)
SMTP_PASS=YourEmailPasswordHere

# Recipient Email Address for Trade Inquiries
SMTP_TO=ashish@vibrantpetro.com
